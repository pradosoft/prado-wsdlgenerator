{
	"name": "pradosoft/prado-wsdlgenerator",
	"type": "library",
	"description": "Wsdl generator used in Prado",
	"keywords": ["wsdl", "soap", "prado"],
	"homepage": "https://github.com/pradosoft/prado-wsdlgenerator",
	"license" : "BSD-3-Clause",
	"authors": [
		{
			"name": "Cristian Losada",
			"email": "cristian@teaxul.com",
			"role" : "Developer"
		},
		{
			"name": "Fabio Bas",
			"email": "ctrlaltca@gmail.com",
			"role" : "Developer"
		},
		{
			"name": "Brad Anderson",
			"email": "belisoful@icloud.com",
			"role" : "Engineer/Developer"
		},
		{
			"name": "Marcus Nyeholt",
			"email": "tanus@users.sourceforge.net",
			"role" : "Developer"
		},
		{
			"name": "Wei Zhuo",
			"email": "weizhuo@gmail.com",
			"role" : "Developer"
		}
	],
	"require": {
		"php": ">=8.1.0",
		"ext-dom": "*",
		"ext-pcre": "*",
		"ext-spl": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^10",
		"friendsofphp/php-cs-fixer": "^3.95",
		"phpstan/phpstan": "^2.1"
	},
	"suggest": {
		"ext-soap": "Used by the SOAP server the generated WSDL describes"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.x-dev"
		}
	},
	"autoload": {
		"psr-4": {
			"Prado\\Wsdl\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Prado\\Wsdl\\Test\\Unit\\": "tests/unit/"
		}
	},
	"config": {
		"platform": {
			"php": "8.1"
		}
	},
	"support": {
		"issues": "https://github.com/pradosoft/prado-wsdlgenerator/issues",
		"source": "https://github.com/pradosoft/prado-wsdlgenerator"
	},
	"scripts": {
		"fix": "vendor/bin/php-cs-fixer fix",
		"check": "vendor/bin/php-cs-fixer fix --dry-run",
		"stan": "vendor/bin/phpstan analyse --memory-limit=512M",
		"unittest": "vendor/bin/phpunit --testsuite unit",
		"fulltest": [
			"@fix",
			"@stan",
			"@unittest"
		]
	}
}
